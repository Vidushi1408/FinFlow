DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finflow

# Flask session signing key. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret
FLASK_ENV=development

# Optional: shares login-rate-limit counters across gunicorn workers/containers via Redis instead
# of an in-process dict. Leave unset for local single-worker dev; required once you run more than
# one worker, or the limit is effectively multiplied by the worker count.
# REDIS_URL=redis://localhost:6379/0

# Optional: local Ollama server for the report page's money-coach chat. Data never leaves this machine.
# Install Ollama, then: ollama pull llama3.2:3b && ollama serve   (try llama3.1:8b for better answers)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# Optional: SMTP for password-reset emails. Without SMTP_HOST the reset link is written to the app log
# (fine for local development; set these for any real deployment).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@yourdomain.com

# Optional: Sentry error tracking. Off unless set. When on, request bodies, cookies, headers and user
# data are never sent (see webapp/observability.py), so transactions don't leave the machine.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

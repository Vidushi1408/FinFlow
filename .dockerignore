# Keep the build context small and keep secrets/data out of the image.
.git
.github
.gitignore

# local environments and secrets (never bake these into an image)
venv/
.venv/
.env

# generated at runtime by the seed step, not part of the image
models/
*.csv
*.pkl
*.joblib

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# not needed to run the app
tests/
.DS_Store
